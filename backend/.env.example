# ==============================================================================
# Medi-Assist Backend Configuration
# ==============================================================================

# Database Connection (Aurora PostgreSQL or local PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/medi_assist

# Google Cloud Platform / Vertex AI (Gemini 2.5 Flash)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Path to GCP Service Account JSON key (for local development)
GOOGLE_APPLICATION_CREDENTIALS=creds.json

# Google Cloud Storage (Bucket for ambient audio recordings)
GCS_BUCKET_NAME=medi-assist-recordings

# Amazon Web Services (Bedrock - Amazon Nova 2 Lite)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_DEFAULT_REGION=us-east-1
AWS_GLOBAL_REGION=global
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
