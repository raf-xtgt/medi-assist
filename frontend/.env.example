# ==============================================================================
# Medi-Assist Frontend Configuration
# ==============================================================================

# FastAPI Backend URL (Used by Next.js server-side rewrites / API proxies)
# Local development: http://localhost:8000
# Production: https://<your-backend-app-runner-url>.amazonaws.com
FASTAPI_URL=http://localhost:8000

# Public API Base URL (Used by client-side browser requests)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Optional: Aurora PostgreSQL / Vercel IAM Integration
# (Only required if connecting serverless frontend functions directly to Aurora)
# ------------------------------------------------------------------------------
# AWS_ACCOUNT_ID="123456789012"
# AWS_REGION="us-east-1"
# AWS_RESOURCE_ARN="arn:aws:rds:us-east-1:123456789012:cluster:your-cluster-name"
# AWS_ROLE_ARN="arn:aws:iam::123456789012:role/Vercel/your-db-access-role"
# PGDATABASE="postgres"
# PGHOST="your-cluster.cluster-xyz.us-east-1.rds.amazonaws.com"
# PGPORT="5432"
# PGSSLMODE="require"
# PGUSER="postgres"
